      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1703478559608832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1703478562627586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;300 THEN &quot;Luxury&quot; ELSEIF [Price]&gt;150 THEN &quot;Standard&quot; ELSE &quot;Budget&quot; END' />
      </column>
      <column caption='Count of hotels' datatype='integer' name='[Calculation_1703478564323331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host status' datatype='string' name='[Calculation_1703478568546308]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;TODAY()THEN &quot;Active Host&quot; ELSE &quot;New Host&quot; END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1703478569070597]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;Highly Review&quot; ELSE &quot;Less Review&quot; END' />
      </column>
      <column caption='Price fielter category' datatype='string' name='[Calculation_1703478570983431]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1703478569897990] THEN &quot;Above Limit&quot; ELSE &quot;Below Limit&quot; End' />
      </column>
      <column caption='new host since' datatype='date' name='[Calculation_1703478577754121]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(01-01-2026))' />
      </column>
      <column caption='new review score rating' datatype='integer' name='[Calculation_1703478579933194]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating (bin)],0)' />
      </column>
